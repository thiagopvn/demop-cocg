rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ============= HELPERS =============
    function isAuth() { return request.auth != null; }
    function getRole() { return request.auth.token.role; }
    function isAdmin() { return isAuth() && (getRole() == 'admin' || getRole() == 'admingeral'); }
    function isAdminGeral() { return isAuth() && getRole() == 'admingeral'; }
    function isChefe() { return isAuth() && getRole() == 'chefe'; }
    function isBensRole() { return isAuth() && getRole() == 'BensPatrimoniais'; }
    // BensPatrimoniais tem acesso operacional equivalente ao admin (exceto exclusões
    // sensíveis e dados de senhas). Veja allowedRoles em src/App.jsx.
    function isAdminOrBens() { return isAdmin() || isBensRole(); }
    function isChefeOrAdmin() { return isAdmin() || isChefe(); }
    function isChefeOrAdminOrBens() { return isChefeOrAdmin() || isBensRole(); }

    // ============= DEFAULT DENY =============
    match /{document=**} { allow read, write: if false; }

    // ============= USERS =============
    // Leitura: qualquer autenticado (para selects, autocompletes).
    // Escrita: admin/BensPatrimoniais (com hierarquia — admingeral é intocável
    // por admin/BensPatrimoniais; somente admingeral cria/altera/exclui admingeral).
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAdminOrBens()
        && (isAdminGeral() || request.resource.data.role != 'admingeral');
      allow update: if isAdminOrBens()
        && (isAdminGeral() || (resource.data.role != 'admingeral' && request.resource.data.role != 'admingeral'));
      allow delete: if isAdminOrBens()
        && (isAdminGeral() || resource.data.role != 'admingeral');
    }

    // ============= USER SECRETS (senhas) =============
    // Apenas admingeral lê. Escrita só via Admin SDK (Cloud Functions).
    match /user_secrets/{userId} {
      allow read: if isAdminGeral();
      allow write: if false;
    }

    // ============= MATERIALS =============
    // Leitura: todos autenticados. CRUD: admin/admingeral/BensPatrimoniais.
    // Chefe pode atualizar (ajuste de estoque durante conferência).
    match /materials/{docId} {
      allow read: if isAuth();
      allow create, delete: if isAdminOrBens();
      allow update: if isChefeOrAdminOrBens();
    }

    // ============= CATEGORIAS =============
    match /categorias/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdminOrBens();
    }

    // ============= VIATURAS (operacionais — /viaturas) =============
    match /viaturas/{docId} {
      allow read: if isAuth();
      allow create, delete: if isAdminOrBens();
      allow update: if isChefeOrAdminOrBens();
    }

    // ============= VIATURA_MATERIAIS (materiais alocados em viaturas operacionais) =============
    match /viatura_materiais/{docId} {
      allow read: if isAuth();
      allow create, delete: if isAdminOrBens();
      allow update: if isChefeOrAdminOrBens();
    }

    // ============= MOVIMENTACOES (cautelas, saídas, reparos, entradas) =============
    // Leitura: todos autenticados.
    // Criação: admin/admingeral/BensPatrimoniais.
    // Atualização: admin/BensPatrimoniais OU o próprio usuário cautelado (para
    // assinar/marcar como ciente da devolução).
    // Exclusão: somente admingeral.
    match /movimentacoes/{docId} {
      allow read: if isAuth();
      allow create: if isAdminOrBens();
      allow delete: if isAdminGeral();
      allow update: if isAdminOrBens()
        || (isAuth()
            && resource.data.user == request.auth.token.firestoreId
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['signed', 'signed_date', 'user_acknowledged_return']));
    }

    // ============= RINGS =============
    match /rings/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdminOrBens();
    }

    // ============= MANUTENCOES =============
    match /manutencoes/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdminOrBens();
    }

    // ============= HISTORICO MANUTENCOES =============
    match /historico_manutencoes/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdminOrBens();
    }

    // ============= COMPRESSORES (controle de uso por horímetro) =============
    // Cadastro/estado do cronômetro do compressor fixo (e futuros equipamentos).
    // Leitura: todos autenticados. Escrita: admin/admingeral/BensPatrimoniais.
    match /compressores/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdminOrBens();
    }

    // ============= COMPRESSOR - HISTORICO DE USO (sessões do cronômetro) =============
    match /compressor_usos/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdminOrBens();
    }

    // ============= COMPRESSOR - HISTORICO DE MANUTENCOES =============
    match /compressor_manutencoes/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdminOrBens();
    }

    // ============= CONFERENCIAS DE VIATURAS =============
    match /conferencias_viaturas/{docId} {
      allow read: if isAuth();
      allow create: if isChefeOrAdminOrBens();
      allow update, delete: if isAdminOrBens();
    }

    // ============= ALERTAS DE CONFERENCIA (chefe -> admin) =============
    match /alertas_conferencia/{docId} {
      allow read: if isAdminOrBens();
      allow create: if isChefeOrAdminOrBens();
      allow update: if isAdminOrBens();
      allow delete: if isAdminGeral();
    }

    // ============= AUDIT LOGS =============
    // Qualquer autenticado cria (log). Só admingeral lê. Imutável (nunca update/delete).
    match /audit_logs/{docId} {
      allow read: if isAdminGeral();
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // ============= BENS PATRIMONIAIS (módulo isolado) =============
    // Acesso estrito: somente role BensPatrimoniais ou admingeral.
    match /bens_patrimoniais/{docId} {
      allow read, create, update, delete: if isBensRole() || isAdminGeral();
    }

    // ============= BENS VIATURAS (viaturas exclusivas do módulo Bens) =============
    // Independente de /viaturas. Acesso estrito: BensPatrimoniais ou admingeral.
    match /bens_viaturas/{docId} {
      allow read, create, update, delete: if isBensRole() || isAdminGeral();
    }

    // ============= BENS DIVERGENTES (itens encontrados fora do arrolamento) =============
    // Itens cadastrados durante conferência que não constam na planilha oficial.
    // Coleção independente para manter a tabela principal limpa.
    match /bens_divergentes/{docId} {
      allow read, create, update, delete: if isBensRole() || isAdminGeral();
    }

    // ============= TAREFAS DEMOP =============
    // Leitura: todos autenticados. Create/Delete: admingeral. Update:
    // admingeral OU admin/BensPatrimoniais (só campos de progresso/conclusão).
    match /tarefas_demop/{docId} {
      allow read: if isAuth();
      allow create, delete: if isAdminGeral();
      allow update: if isAdminGeral()
        || (isAdminOrBens()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['progress', 'status', 'completedAt', 'completedBy', 'completedByName']));
    }
  }
}
