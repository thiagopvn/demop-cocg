rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ============= HELPERS =============
    function isAuth() { return request.auth != null; }
    function getRole() { return request.auth.token.role; }
    function isAdmin() { return isAuth() && (getRole() == 'admin' || getRole() == 'admingeral'); }
    function isAdminGeral() { return isAuth() && getRole() == 'admingeral'; }
    function isChefe() { return isAuth() && getRole() == 'chefe'; }
    function isBensRole() { return isAuth() && getRole() == 'BensPatrimoniais'; }
    // BensPatrimoniais tem acesso operacional equivalente ao admin (exceto exclusões
    // sensíveis e dados de senhas). Veja allowedRoles em src/App.jsx.
    function isAdminOrBens() { return isAdmin() || isBensRole(); }
    function isChefeOrAdmin() { return isAdmin() || isChefe(); }
    function isChefeOrAdminOrBens() { return isChefeOrAdmin() || isBensRole(); }

    // ============= DEFAULT DENY =============
    match /{document=**} { allow read, write: if false; }

    // ============= USERS =============
    // Leitura: qualquer autenticado (para selects, autocompletes).
    // Escrita: admin/BensPatrimoniais (com hierarquia — admingeral é intocável
    // por admin/BensPatrimoniais; somente admingeral cria/altera/exclui admingeral).
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAdminOrBens()
        && (isAdminGeral() || request.resource.data.role != 'admingeral');
      allow update: if (isAdminOrBens()
        && (isAdminGeral() || (resource.data.role != 'admingeral' && request.resource.data.role != 'admingeral')))
        // O próprio militar pode editar apenas dados de perfil (nome, contato e foto).
        || (isAuth()
            && request.auth.token.firestoreId == userId
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['full_name', 'full_name_lower', 'email', 'telefone', 'foto_url', 'foto_storagePath', 'foto_atualizada_em']));
      allow delete: if isAdminOrBens()
        && (isAdminGeral() || resource.data.role != 'admingeral');
    }

    // ============= USER SECRETS (senhas) =============
    // Apenas admingeral lê. Escrita só via Admin SDK (Cloud Functions).
    match /user_secrets/{userId} {
      allow read: if isAdminGeral();
      allow write: if false;
    }

    // ============= MATERIALS =============
    // Leitura: todos autenticados. CRUD: admin/admingeral/BensPatrimoniais.
    // Chefe pode atualizar (ajuste de estoque durante conferência).
    match /materials/{docId} {
      allow read: if isAuth();
      allow create, delete: if isAdminOrBens();
      allow update: if isChefeOrAdminOrBens();
    }

    // ============= CATEGORIAS =============
    match /categorias/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdminOrBens();
    }

    // ============= VIATURAS (operacionais — /viaturas) =============
    match /viaturas/{docId} {
      allow read: if isAuth();
      allow create, delete: if isAdminOrBens();
      allow update: if isChefeOrAdminOrBens();
    }

    // ============= VIATURA_MATERIAIS (materiais alocados em viaturas operacionais) =============
    match /viatura_materiais/{docId} {
      allow read: if isAuth();
      allow create, delete: if isAdminOrBens();
      allow update: if isChefeOrAdminOrBens();
    }

    // ============= LOCAIS DE ARMAZENAMENTO (prateleiras, box, gavetas, armários) =============
    // Leitura: todos autenticados (chips de "onde guardar"). Escrita: admin/BensPatrimoniais.
    match /locais_armazenamento/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdminOrBens();
    }

    // ============= MATERIAL_LOCAIS (unidades de cada material por local do DEMOP) =============
    match /material_locais/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdminOrBens();
    }

    // ============= MOVIMENTACOES (cautelas, saídas, reparos, entradas) =============
    // Leitura: todos autenticados.
    // Criação: admin/admingeral/BensPatrimoniais.
    // Atualização: admin/BensPatrimoniais OU o próprio usuário cautelado (para
    // assinar/marcar como ciente da devolução).
    // Exclusão: somente admingeral.
    match /movimentacoes/{docId} {
      allow read: if isAuth();
      allow create: if isAdminOrBens();
      allow delete: if isAdminGeral();
      allow update: if isAdminOrBens()
        || (isAuth()
            && resource.data.user == request.auth.token.firestoreId
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['signed', 'signed_date', 'user_acknowledged_return']));
    }

    // ============= RINGS =============
    match /rings/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdminOrBens();
    }

    // ============= MANUTENCOES =============
    match /manutencoes/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdminOrBens();
    }

    // ============= HISTORICO MANUTENCOES =============
    match /historico_manutencoes/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdminOrBens();
    }

    // ============= COMPRESSORES (controle de uso por horímetro) =============
    // Cadastro/estado do cronômetro do compressor fixo (e futuros equipamentos).
    // Leitura: todos autenticados. Escrita: admin/admingeral/BensPatrimoniais.
    match /compressores/{docId} {
      allow read: if isAuth();
      allow create, update: if isAdminOrBens();
      allow delete: if isAdminGeral();
    }

    // ============= COMPRESSOR - HISTORICO DE USO (sessões do cronômetro) =============
    // Exclusão restrita a admingeral (correção de registros).
    match /compressor_usos/{docId} {
      allow read: if isAuth();
      allow create, update: if isAdminOrBens();
      allow delete: if isAdminGeral();
    }

    // ============= COMPRESSOR - HISTORICO DE MANUTENCOES =============
    // Exclusão restrita a admingeral (correção de registros).
    match /compressor_manutencoes/{docId} {
      allow read: if isAuth();
      allow create, update: if isAdminOrBens();
      allow delete: if isAdminGeral();
    }

    // ============= CONFERENCIAS DE VIATURAS =============
    match /conferencias_viaturas/{docId} {
      allow read: if isAuth();
      allow create: if isChefeOrAdminOrBens();
      allow update, delete: if isAdminOrBens();
    }

    // ============= ALERTAS DE CONFERENCIA (chefe -> admin) =============
    match /alertas_conferencia/{docId} {
      allow read: if isAdminOrBens();
      allow create: if isChefeOrAdminOrBens();
      allow update: if isAdminOrBens();
      allow delete: if isAdminGeral();
    }

    // ============= AUDIT LOGS =============
    // Qualquer autenticado cria (log). Só admingeral lê. Imutável (nunca update/delete).
    match /audit_logs/{docId} {
      allow read: if isAdminGeral();
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // ============= BENS PATRIMONIAIS (módulo isolado) =============
    // Acesso estrito: somente role BensPatrimoniais ou admingeral.
    match /bens_patrimoniais/{docId} {
      allow read, create, update, delete: if isBensRole() || isAdminGeral();
    }

    // ============= BENS VIATURAS (viaturas exclusivas do módulo Bens) =============
    // Independente de /viaturas. Acesso estrito: BensPatrimoniais ou admingeral.
    match /bens_viaturas/{docId} {
      allow read, create, update, delete: if isBensRole() || isAdminGeral();
    }

    // ============= BENS DIVERGENTES (itens encontrados fora do arrolamento) =============
    // Itens cadastrados durante conferência que não constam na planilha oficial.
    // Coleção independente para manter a tabela principal limpa.
    match /bens_divergentes/{docId} {
      allow read, create, update, delete: if isBensRole() || isAdminGeral();
    }

    // ============= TAREFAS DEMOP =============
    // Leitura: todos autenticados. Create/Delete: admingeral. Update:
    // admingeral OU admin/BensPatrimoniais (só campos de progresso/conclusão).
    match /tarefas_demop/{docId} {
      allow read: if isAuth();
      allow create, delete: if isAdminGeral();
      allow update: if isAdminGeral()
        || (isAdminOrBens()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['progress', 'status', 'completedAt', 'completedBy', 'completedByName']));
    }
    // ============= PRESENÇA E SESSÕES (quem está online, entradas e saídas) =============
    function meuId() { return request.auth.token.firestoreId; }
    // presenca/{userId}: o próprio militar mantém; todos leem (bolinha online no chat).
    match /presenca/{userId} {
      allow read: if isAuth();
      allow create, update: if isAuth() && meuId() == userId;
      allow delete: if isAdminGeral();
    }
    // sessoes: histórico de login/logout. Só o admingeral lê; o militar cria/atualiza a própria.
    match /sessoes/{docId} {
      allow read: if isAdminGeral();
      allow create: if isAuth() && request.resource.data.userId == meuId();
      allow update: if isAuth() && resource.data.userId == meuId();
      allow delete: if isAdminGeral();
    }

    // ============= MENSAGENS (chat interno) =============
    function idPar(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function saoAmigos(a, b) {
      return exists(/databases/$(database)/documents/amizades/$(idPar(a, b)))
        && get(/databases/$(database)/documents/amizades/$(idPar(a, b))).data.status == 'aceita';
    }
    function papelDe(uid) { return get(/databases/$(database)/documents/users/$(uid)).data.role; }
    function outroParticipante(lista) { return lista[0] == meuId() ? lista[1] : lista[0]; }
    // Quem pode abrir conversa com quem: admingeral/admin com qualquer um;
    // demais papéis só com o admingeral ou com um amigo (pedido aceito).
    function podeIniciarConversa(outro) {
      return isAdmin() || papelDe(outro) == 'admingeral' || saoAmigos(meuId(), outro);
    }
    function participaDaConversa(convId) {
      return meuId() in get(/databases/$(database)/documents/conversas/$(convId)).data.participantes;
    }
    match /conversas/{convId} {
      allow read: if isAuth() && (isAdminGeral() || meuId() in resource.data.participantes);
      allow create: if isAuth()
        && request.resource.data.participantes.size() == 2
        && meuId() in request.resource.data.participantes
        && convId == idPar(request.resource.data.participantes[0], request.resource.data.participantes[1])
        && podeIniciarConversa(outroParticipante(request.resource.data.participantes));
      allow update: if isAuth() && meuId() in resource.data.participantes
        && request.resource.data.participantes == resource.data.participantes;
      allow delete: if isAdminGeral();

      match /mensagens/{msgId} {
        allow read: if isAuth() && (isAdminGeral() || participaDaConversa(convId));
        allow create: if isAuth() && participaDaConversa(convId)
          && request.resource.data.de == meuId();
        // Só o destinatário marca como lida / responde um card (status)
        allow update: if isAuth() && participaDaConversa(convId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida', 'lida_em', 'card']);
        allow delete: if isAdminGeral();
      }
    }

    // ============= AMIZADES (pedido aceito pelo outro) =============
    match /amizades/{docId} {
      allow read: if isAuth() && (isAdminGeral() || meuId() in resource.data.usuarios);
      allow create: if isAuth()
        && request.resource.data.usuarios.size() == 2
        && request.resource.data.solicitante == meuId()
        && meuId() in request.resource.data.usuarios
        && docId == idPar(request.resource.data.usuarios[0], request.resource.data.usuarios[1])
        && request.resource.data.status == 'pendente';
      allow update: if isAuth() && resource.data.destinatario == meuId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'aceita_em']);
      allow delete: if isAuth() && (isAdminGeral() || meuId() in resource.data.usuarios);
    }

    // ============= TRANSFERÊNCIAS DE CAUTELA (entre amigos, pelo chat) =============
    // Criada por quem tem a cautela; aceita/recusada pela Cloud Function responderTransferencia.
    match /transferencias/{docId} {
      allow read: if isAuth() && (isAdminGeral() || resource.data.de == meuId() || resource.data.para == meuId());
      allow create: if isAuth()
        && request.resource.data.de == meuId()
        && request.resource.data.status == 'pendente'
        && saoAmigos(meuId(), request.resource.data.para)
        && get(/databases/$(database)/documents/movimentacoes/$(request.resource.data.movimentacaoId)).data.user == meuId()
        && get(/databases/$(database)/documents/movimentacoes/$(request.resource.data.movimentacaoId)).data.status == 'cautelado';
      // Quem enviou pode cancelar enquanto pendente
      allow update: if isAuth() && resource.data.de == meuId() && resource.data.status == 'pendente'
        && request.resource.data.status == 'cancelada'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondida_em']);
      allow delete: if isAdminGeral();
    }

    // ============= TOKENS DE PUSH (notificações no celular) =============
    match /fcm_tokens/{userId} {
      allow read, create, update, delete: if isAuth() && meuId() == userId;
    }
  }
}
