rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Anexos de reparos (inoperante/inativo): qualquer usuário autenticado
    // pode anexar/remover, pois a movimentação é feita por papéis
    // operacionais (chefe, BensPatrimoniais) além de admin/admingeral.
    match /reparos/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (request.auth.token.role == 'admin' || request.auth.token.role == 'admingeral');
    }
  }
}
